{
  "name": "GAVYO Estoque",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": { "label": "GAVYO Estoque", "onAutoForward": "openBrowser" },
    "3000": { "label": "API (interna)", "onAutoForward": "silent" },
    "5432": { "label": "Postgres", "onAutoForward": "silent" }
  },
  "postCreateCommand": "corepack enable && corepack prepare --activate && pnpm install && node .devcontainer/setup-env.mjs",
  "customizations": {
    "vscode": { "extensions": ["anthropic.claude-code", "openai.chatgpt"] }
  }
}
