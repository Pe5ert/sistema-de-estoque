@keyframes particleFloat {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  25% { transform: translateY(-10px) rotate(90deg); }
  50% { transform: translateY(-5px) rotate(180deg); }
  75% { transform: translateY(-15px) rotate(270deg); }
}

/* Efeito de scan line digital */
.card-scan {
  position: relative;
  overflow: hidden;
}

.card-scan::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 2px;
  background: linear-gradient(90deg, transparent, rgba(92, 209, 216, 0.8), rgba(255, 80, 49, 0.8), transparent);
  animation: scanLine 3s linear infinite;
  z-index: 1;
}

@keyframes scanLine {
  0% { top: 0; }
  50% { top: 50%; }
  100% { top: 100%; }
}

/* Brilho neon pulsante para elementos interativos */
.neon-glow {
  position: relative;
  text-shadow: 0 0 5px rgba(92, 209, 216, 0.5), 0 0 10px rgba(92, 209, 216, 0.5), 0 0 15px rgba(92, 209, 216, 0.5);
  animation: neonPulse 2s ease-in-out infinite alternate;
}

