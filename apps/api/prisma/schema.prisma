generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  OPERATOR
}

enum ProductUnit {
  UNIT
  BOX
  PACK
  KG
  G
  LITER
  ML
  METER
}

enum MovementType {
  ENTRY
  EXIT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum MovementReason {
  PURCHASE
  SALE
  INTERNAL_USE
  RETURN
  LOSS
  INVENTORY_ADJUSTMENT
  OTHER
}

model User {
  id             String          @id @default(uuid()) @db.Uuid
  name           String          @db.VarChar(120)
  email          String          @unique @db.VarChar(180)
  passwordHash   String          @db.VarChar(255)
  role           UserRole        @default(OPERATOR)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stockMovements StockMovement[]
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(120)
  description String?   @db.VarChar(500)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id             String          @id @default(uuid()) @db.Uuid
  sku            String          @unique @db.VarChar(80)
  barcode        String?         @unique @db.VarChar(80)
  name           String          @db.VarChar(200)
  description    String?         @db.Text
  categoryId     String          @db.Uuid
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit           ProductUnit     @default(UNIT)
  costPrice      Decimal         @db.Decimal(18, 2)
  salePrice      Decimal         @db.Decimal(18, 2)
  stock          Decimal         @default(0) @db.Decimal(18, 3)
  minimumStock   Decimal         @default(0) @db.Decimal(18, 3)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stockMovements StockMovement[]

  @@index([name])
  @@index([categoryId, active])
}

model StockMovement {
  id             String         @id @default(uuid()) @db.Uuid
  productId      String         @db.Uuid
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  userId         String         @db.Uuid
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  type           MovementType
  quantity       Decimal        @db.Decimal(18, 3)
  previousStock  Decimal        @db.Decimal(18, 3)
  resultingStock Decimal        @db.Decimal(18, 3)
  reason         MovementReason
  reference      String?        @db.VarChar(120)
  notes          String?        @db.Text
  createdAt      DateTime       @default(now())

  @@index([productId, createdAt])
  @@index([userId, createdAt])
}
