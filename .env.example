# Apenas desenvolvimento local. Copie para .env e altere as senhas antes de uso compartilhado.
DATABASE_URL=postgresql://stock_dev:stock_dev@localhost:5432/stock_v2?schema=public
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development

# Infraestrutura local do Docker Compose
POSTGRES_USER=stock_dev
POSTGRES_PASSWORD=stock_dev
POSTGRES_DB=stock_v2

# Seed local. Use uma senha diferente fora do seu computador.
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=ChangeMe123!
