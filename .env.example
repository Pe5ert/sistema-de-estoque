# Apenas desenvolvimento local. Copie para .env e altere as senhas antes de uso compartilhado.
DATABASE_URL=postgresql://stock_dev:stock_dev@localhost:5432/stock_v2?schema=public
API_PORT=3000
# Origem exata do frontend, sem barra final (CORS + proteção CSRF).
WEB_ORIGIN=http://localhost:5173
# Gere um segredo aleatório de ao menos 32 caracteres; obrigatório, sem fallback.
JWT_SECRET=
# URL pública da API, incluindo o prefixo /api. Vite lê o .env da raiz.
VITE_API_URL=http://localhost:3000/api
NODE_ENV=development

# Infraestrutura local do Docker Compose
POSTGRES_USER=stock_dev
POSTGRES_PASSWORD=stock_dev
POSTGRES_DB=stock_v2

# Seed local. Use uma senha diferente fora do seu computador.
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# Backups completos. Instale pg_dump/pg_restore da mesma versão principal do servidor
# ou de uma versão compatível mais recente. Não use uma pasta pública da aplicação.
# Caminho relativo ao processo da API (pnpm executa em apps/api).
BACKUP_DIRECTORY=../../var/backups
BACKUP_PG_DUMP_PATH=pg_dump
BACKUP_PG_RESTORE_PATH=pg_restore
# Padrão mensal no primeiro dia. O ADMIN pode escolher semanal/mensal pela tela.
# O agendamento salvo na tela tem prioridade sobre estes valores iniciais.
BACKUP_AUTO_ENABLED=true
BACKUP_HOUR=02:00
BACKUP_TIME_ZONE=America/Fortaleza
BACKUP_RETENTION_DAYS=365
BACKUP_TIMEOUT_SECONDS=1800
# Para Neon: use a conexão direta/unpooled para pg_dump.
# Opcional: BACKUP_DATABASE_URL; se ausente, usa DIRECT_URL, depois DATABASE_URL.
# BACKUP_DATABASE_URL=postgresql://...
# DIRECT_URL=postgresql://...
