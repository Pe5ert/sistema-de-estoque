generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  OPERATOR
}

enum ProductUnit {
  UNIT
  BOX
  PACK
  KG
  G
  LITER
  ML
  METER
}

enum MovementType {
  ENTRY
  EXIT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum MovementReason {
  INITIAL_STOCK
  PURCHASE
  SALE
  INTERNAL_USE
  RETURN
  LOSS
  INVENTORY_ADJUSTMENT
  OTHER
}

model User {
  id             String          @id @default(uuid()) @db.Uuid
  name           String          @db.VarChar(120)
  email          String          @unique @db.VarChar(180)
  passwordHash   String          @db.VarChar(255)
  role           UserRole        @default(OPERATOR)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stockMovements StockMovement[]
  importJobs     ImportJob[]
  physicalInventoriesCreated PhysicalInventory[] @relation("InventoryCreator")
  physicalInventoriesCompleted PhysicalInventory[] @relation("InventoryCompleter")
  physicalInventoriesCancelled PhysicalInventory[] @relation("InventoryCanceller")
  physicalInventoryCounts PhysicalInventoryItem[]
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(120)
  description String?   @db.VarChar(500)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  physicalInventories PhysicalInventory[]
}

model Product {
  id             String          @id @default(uuid()) @db.Uuid
  sku            String          @unique @db.VarChar(80)
  barcode        String?         @unique @db.VarChar(80)
  name           String          @db.VarChar(200)
  description    String?         @db.Text
  categoryId     String          @db.Uuid
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit           ProductUnit     @default(UNIT)
  imageUrl       String?         @db.VarChar(2048)
  costPrice      Decimal?        @db.Decimal(18, 2)
  salePrice      Decimal?        @db.Decimal(18, 2)
  stock          Decimal         @default(0) @db.Decimal(18, 3)
  minimumStock   Decimal         @default(0) @db.Decimal(18, 3)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stockMovements StockMovement[]

  physicalInventoryItems PhysicalInventoryItem[]

  @@index([name])
  @@index([categoryId, active])
}

model StockMovement {
  id             String         @id @default(uuid()) @db.Uuid
  productId      String         @db.Uuid
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  userId         String         @db.Uuid
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  type           MovementType
  quantity       Decimal        @db.Decimal(18, 3)
  previousStock  Decimal        @db.Decimal(18, 3)
  resultingStock Decimal        @db.Decimal(18, 3)
  reason         MovementReason
  reference      String?        @db.VarChar(120)
  notes          String?        @db.Text
  createdAt      DateTime       @default(now())

  @@index([productId, createdAt])
  @@index([userId, createdAt])
}

enum ImportStatus {
  PREVIEW
  PROCESSING
  COMPLETED
  FAILED
}

model ImportJob {
  id               String       @id @default(uuid()) @db.Uuid
  status           ImportStatus @default(PREVIEW)
  createdBy        String       @db.Uuid
  creator          User         @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  fileName         String       @db.VarChar(255)
  format           String       @db.VarChar(4)
  delimiter        String?      @db.VarChar(1)
  headers          Json
  rows             Json
  mapping          Json
  categoryMappings Json
  revision         Int          @default(1)
  totalRows        Int
  ignoredRows      Int          @default(0)
  importedRows     Int          @default(0)
  result           Json?
  error            String?      @db.VarChar(500)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([createdBy, createdAt])
}


enum PhysicalInventoryStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model PhysicalInventory {
  id                String @id @default(uuid()) @db.Uuid
  title             String @db.VarChar(160)
  status            PhysicalInventoryStatus @default(DRAFT)
  revision          Int @default(1)
  categoryId        String? @db.Uuid
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryName      String? @db.VarChar(120)
  createdById       String @db.Uuid
  createdBy         User @relation("InventoryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  completedById     String? @db.Uuid
  completedBy       User? @relation("InventoryCompleter", fields: [completedById], references: [id], onDelete: Restrict)
  cancelledById     String? @db.Uuid
  cancelledBy       User? @relation("InventoryCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancellationNotes String? @db.VarChar(1000)
  adjustmentCount   Int @default(0)
  items             PhysicalInventoryItem[]

  @@index([status, createdAt])
  @@index([createdById, createdAt])
}

model PhysicalInventoryItem {
  inventoryId           String @db.Uuid
  inventory             PhysicalInventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  productId             String @db.Uuid
  product               Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku                   String @db.VarChar(80)
  name                  String @db.VarChar(200)
  unit                  ProductUnit
  snapshotStock         Decimal @db.Decimal(18,3)
  snapshotUpdatedAt     DateTime
  snapshotMovementCount Int
  countedQuantity       Decimal? @db.Decimal(18,3)
  notes                 String? @db.VarChar(1000)
  countedById           String? @db.Uuid
  countedBy             User? @relation(fields: [countedById], references: [id], onDelete: Restrict)
  countedAt             DateTime?

  @@id([inventoryId, productId])
  @@index([productId])
}
